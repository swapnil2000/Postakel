# Application
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://yourdomain.vercel.app

# Database - Master (For company signup and subscription management)
# This should point to the admin-backend database
MASTER_DATABASE_URL=postgresql://postgres:hello@localhost:5432/admin_db?schema=public

# Database - Tenant (For employee and company-specific data)
DATABASE_URL=postgresql://postgres:hello@localhost:5432/master_db?schema=public

# JWT Configuration
JWT_SECRET=cb54c5c36f498db4eac476f3587dfcb2bdf3212c708d8e89f6a3d1c48c0a510a
JWT_EXPIRATION=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@postakel.com

# Admin Backend Integration
ADMIN_BACKEND_URL=http://localhost:4001/api
ADMIN_BACKEND_PRODUCTION_URL=https://admin-backend-domain.com/api

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=postakel-uploads

# Tenant Configuration
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=password

# Stripe (Optional - for payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Logging
LOG_LEVEL=debug
